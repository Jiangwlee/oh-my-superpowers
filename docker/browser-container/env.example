# Copy to .env and adjust. All values are consumed by compose.yaml.

# Bearer token for the REST/MCP endpoints. Leave empty to disable auth
# (single-user, trusted local network only).
OMP_BROWSER_TOKEN=

# Interface to publish ports on. Loopback by default — the interactive VNC port
# is a password-less live browser; do NOT bind to 0.0.0.0. Use a trusted
# interface (e.g. Tailscale IP) only if you must reach it from another host.
BIND_ADDR=127.0.0.1

# Optional upstream proxy for the browser. Leave empty for a direct connection.
# HTTP or SOCKS, e.g. http://192.168.5.212:10801 or socks5://127.0.0.1:1080.
# No-auth proxies only — Chrome's --proxy-server cannot pass user:pass.
OMP_BROWSER_PROXY=
# Hosts that bypass the proxy (Chrome --proxy-bypass-list syntax),
# e.g. localhost;127.0.0.1;*.internal
OMP_BROWSER_NO_PROXY=

# Host port mappings.
REST_PORT=8080
MCP_PORT=9223
VNC_VIEWONLY_PORT=6080
VNC_INTERACTIVE_PORT=6081
