{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AShareReviewSchemaV1",
  "type": "object",
  "required": [
    "run_id",
    "as_of_date",
    "market",
    "funding",
    "candidates",
    "risk_flags"
  ],
  "properties": {
    "run_id": {"type": "string", "pattern": "^\\d{8}-[A-Za-z0-9_.-]+-\\d{6}$"},
    "as_of_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "market": {
      "type": "object",
      "required": ["regime"],
      "properties": {
        "regime": {"type": "string", "enum": ["strong", "neutral", "weak"]}
      }
    },
    "funding": {
      "type": "object",
      "required": ["data_degraded"],
      "properties": {
        "northbound_net": {"type": "number"},
        "main_force_top20": {"type": "array"},
        "data_degraded": {"type": "boolean"}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "score", "action", "thesis_short", "risk_note"],
        "properties": {
          "code": {"type": "string"},
          "name": {"type": "string"},
          "score": {"type": "number"},
          "action": {"type": "string", "enum": ["buy", "hold", "sell", "watch"]},
          "thesis_short": {"type": "string", "maxLength": 30},
          "risk_note": {"type": "string", "maxLength": 30}
        }
      }
    },
    "risk_flags": {
      "type": "object",
      "required": ["data_degraded", "output_schema_invalid", "strategy_version_fallback"],
      "properties": {
        "data_degraded": {"type": "boolean"},
        "output_schema_invalid": {"type": "boolean"},
        "strategy_version_fallback": {"type": "boolean"}
      }
    }
  }
}
