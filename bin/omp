#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["typer", "rich"]
# ///
#
# omp — oh-my-superpowers CLI
#
# Commands:
#   install <skill|agent> <name> [--global]                  安装 skill 或 agent
#   remove  <skill|agent> <name> [--global]                  卸载 skill 或 agent
#   list    [--type skill|agent] [--global]                  列出已安装的 skills 和 agents
#   run     <name> [--mode text|stream|json|interactive]     运行 Pi Agent
#   test    <name>                                           运行 skill T1 测试
#
# Source of truth: ~/.oh-my-superpowers/ (bootstrapped by install.sh)

import json
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Annotated, Optional

import typer
from rich.console import Console

# ── constants ─────────────────────────────────────────────────────────────────

OMP_HOME = Path.home() / ".oh-my-superpowers"
sys.path.insert(0, str(OMP_HOME / "lib"))
SKILLS_SRC = OMP_HOME / "skills"
AGENTS_SRC = OMP_HOME / "agents"
AGENTS_CFG = AGENTS_SRC / "agents.json"
RUN_MODES = {"text", "stream", "json", "interactive"}

# ── app setup ─────────────────────────────────────────────────────────────────

console = Console(stderr=True)
app = typer.Typer(
    name="omp",
    help="oh-my-superpowers CLI",
    add_completion=False,
    no_args_is_help=True,
)

# ── helpers ───────────────────────────────────────────────────────────────────


def _check_home() -> None:
    """检查 OMP_HOME 存在，否则 exit 1。"""
    if not OMP_HOME.exists():
        console.print("[red][omp] ERROR:[/red] ~/.oh-my-superpowers not found. Run install.sh first.")
        raise typer.Exit(1)


def _symlink(src: Path, dst: Path) -> None:
    """创建或更新 symlink dst -> src。"""
    dst.parent.mkdir(parents=True, exist_ok=True)
    if dst.is_symlink():
        dst.unlink()
    elif dst.exists():
        console.print(f"[red][omp] ERROR:[/red] {dst} exists and is not a symlink. Remove manually.")
        raise typer.Exit(1)
    dst.symlink_to(src)
    console.print(f"[omp] linked [cyan]{dst}[/cyan] -> {src}")


def _remove_link(dst: Path) -> None:
    """删除 symlink。"""
    if dst.is_symlink():
        dst.unlink()
        console.print(f"[omp] removed [cyan]{dst}[/cyan]")
    elif dst.exists():
        console.print(f"[red][omp] ERROR:[/red] {dst} exists but is not a symlink. Remove manually.")
        raise typer.Exit(1)
    else:
        console.print(f"[yellow][omp] WARNING:[/yellow] {dst} not found, nothing to remove.")


def _list_dir(label: str, directory: Path) -> None:
    """列出目录下所有条目，显示 symlink 目标。"""
    if not directory.is_dir():
        return
    items = sorted(directory.iterdir())
    if not items:
        return
    console.print(f"\n[bold]{label}[/bold] ({directory}):")
    for item in items:
        if item.is_symlink():
            console.print(f"  {item.name:<30} -> {item.resolve()}")
        else:
            console.print(f"  {item.name}")


def _read_agents_cfg() -> dict:
    """读取 agents/agents.json。"""
    if not AGENTS_CFG.exists():
        return {}
    return json.loads(AGENTS_CFG.read_text())


def _resolve_path(path_str: str) -> Path:
    """解析 @ 前缀路径（相对于 OMP_HOME）。"""
    if path_str.startswith("@"):
        return OMP_HOME / path_str[1:]
    return Path(path_str)


def _extract_frontmatter_field(path: Path, field: str) -> str:
    """从 Pi frontmatter 提取指定字段值。"""
    in_front = False
    for line in path.read_text().splitlines():
        if line == "---":
            if not in_front:
                in_front = True
                continue
            break
        if in_front and line.startswith(f"{field}:"):
            return line[len(f"{field}:") :].strip()
    return ""


def _extract_system_prompt(path: Path) -> str:
    """提取 Pi frontmatter 之后的 system prompt 内容。"""
    lines = path.read_text().splitlines()
    dash_count = 0
    result: list[str] = []
    for line in lines:
        if line == "---":
            dash_count += 1
            continue
        if dash_count >= 2:
            result.append(line)
    return "\n".join(result).strip()


def _read_skill_description(skill_md: Path) -> str:
    """从 SKILL.md frontmatter 提取 description 字段。"""
    if not skill_md.is_file():
        return ""
    in_front = False
    in_desc = False
    lines: list[str] = []
    for raw in skill_md.read_text().splitlines():
        line = raw.rstrip()
        if line == "---":
            if not in_front:
                in_front = True
                continue
            break
        if in_front and line.startswith("description:"):
            in_desc = True
            val = line[len("description:") :].strip().lstrip(">-").strip()
            if val:
                lines.append(val)
        elif in_front and in_desc and line.startswith("  "):
            lines.append(line.strip())
        elif in_front and in_desc:
            break
    max_desc = 120 - 33
    full = " ".join(lines)
    return full[:max_desc] + ("..." if len(full) > max_desc else "")


def _list_not_installed_skills(install_dir: Path) -> None:
    """列出 SKILLS_SRC 中有但 install_dir 中没有的 skill。"""
    if not SKILLS_SRC.is_dir():
        return
    installed = {p.name for p in install_dir.iterdir()} if install_dir.is_dir() else set()
    available = sorted(p.name for p in SKILLS_SRC.iterdir() if p.is_dir())
    not_installed = [skill for skill in available if skill not in installed]
    if not not_installed:
        return
    console.print("\n[bold]not installed[/bold] (available in source):")
    for skill in not_installed:
        desc = _read_skill_description(SKILLS_SRC / skill / "SKILL.md")
        console.print(f"  {skill:<30} {desc}")


def _list_available_agents() -> None:
    """读取 agents.json 并打印每个 agent 的信息。"""
    cfg = _read_agents_cfg()
    if not cfg:
        return
    console.print(f"\n[bold]available agents[/bold] ({AGENTS_CFG}):")
    for name, entry in cfg.items():
        model = entry.get("model", "")
        agent_path = entry.get("agent", "")
        resolved = str(_resolve_path(agent_path)) if agent_path else ""
        skills = entry.get("skills", [])
        skills_display = f"{len(skills)} skills" if skills else "no agent-specific skills"
        console.print(f"  {name:<25} model={model}  agent={resolved}  ({skills_display})")


def _supports_color() -> bool:
    """是否为当前 stdout 启用 ANSI 颜色。"""
    return sys.stdout.isatty()


def _ansi(text: str, code: str) -> str:
    """按需应用 ANSI 颜色。"""
    if not _supports_color():
        return text
    return f"\033[{code}m{text}\033[0m"


def _write_stdout(text: str) -> None:
    """写入 stdout 并立即 flush。"""
    sys.stdout.write(text)
    sys.stdout.flush()


def _truncate(value: str, limit: int = 120) -> str:
    """截断长文本用于单行摘要。"""
    compact = " ".join(value.strip().split())
    if len(compact) <= limit:
        return compact
    return f"{compact[:limit - 3]}..."


def _summarize_content(result: dict) -> str:
    """从 tool result 中提取首选文本摘要。"""
    for item in result.get("content", []):
        if item.get("type") == "text":
            text = item.get("text", "").strip()
            if not text:
                continue
            lines = text.splitlines()
            first_line = _truncate(lines[0], 100)
            if len(lines) > 1:
                return f"{first_line} (+{len(lines) - 1} lines)"
            return first_line
    return "no text output"


def _summarize_args(args: dict) -> str:
    """将工具参数压缩为单行摘要。"""
    if not args:
        return "-"
    parts: list[str] = []
    for key, value in args.items():
        rendered = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
        parts.append(f"{key}={_truncate(str(rendered), 80)}")
    return " ".join(parts)


def _extract_usage(message: dict) -> dict[str, int]:
    """从 assistant message 中提取 usage。"""
    usage = message.get("usage", {})
    return {
        "input": int(usage.get("input", 0) or 0),
        "output": int(usage.get("output", 0) or 0),
        "cacheRead": int(usage.get("cacheRead", 0) or 0),
        "cacheWrite": int(usage.get("cacheWrite", 0) or 0),
        "totalTokens": int(usage.get("totalTokens", 0) or 0),
    }


def _build_run_context(name: str, model: Optional[str]) -> dict:
    """解析 agent 配置并构造统一的 run 上下文。"""
    cfg = _read_agents_cfg()
    entry = cfg.get(name)
    if not entry:
        console.print(f"[red][omp] ERROR:[/red] agent '{name}' not found in agents.json")
        raise typer.Exit(1)

    agent_path = _resolve_path(entry.get("agent", ""))
    if not agent_path.is_file():
        console.print(f"[red][omp] ERROR:[/red] agent file '{agent_path}' not found")
        raise typer.Exit(1)

    effective_model = model or entry.get("model", "litellm-local/qwen3.5-27b")
    skill_flags: list[str] = []
    for skill in entry.get("skills", []):
        path = _resolve_path(skill)
        skill_flags += ["--skill", str(path)]

    tools = _extract_frontmatter_field(agent_path, "tools") or "bash,read"
    tools = tools.replace(" ", "")
    system_prompt = _extract_system_prompt(agent_path)
    return {
        "name": name,
        "agent_path": agent_path,
        "model": effective_model,
        "skill_flags": skill_flags,
        "tools": tools,
        "system_prompt": system_prompt,
    }


def _build_pi_cmd(run_ctx: dict, mode: str, prompt_str: str) -> list[str]:
    """根据 mode 构建对应的 pi 命令。"""
    base = [
        "pi",
        "--no-session",
        "--model",
        run_ctx["model"],
        "--tools",
        run_ctx["tools"],
        *run_ctx["skill_flags"],
        "--system-prompt",
        run_ctx["system_prompt"],
    ]

    if mode == "text":
        return [*base, "--print", prompt_str]
    if mode == "json":
        return [*base, "--mode", "json", "--print", prompt_str]
    if mode == "stream":
        return [*base, "--mode", "json", "--print", prompt_str]
    if mode == "interactive":
        if prompt_str:
            return [*base, prompt_str]
        return base

    raise ValueError(f"unsupported mode: {mode}")


def _run_passthrough(cmd: list[str]) -> int:
    """以继承 stdio 的方式运行子进程。"""
    return subprocess.call(cmd)


def _run_stream(cmd: list[str], run_ctx: dict) -> int:
    """消费 pi JSON 事件并渲染为彩色流式文本。"""
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stdin=subprocess.DEVNULL,
        stderr=None,
        text=True,
    )

    start_ts = time.time()
    in_text_stream = False
    line_open = False
    pending_trailing_newlines = ""
    assistant_stream_open = False
    tools_started = 0
    tool_errors = 0
    pending_tools: dict[str, dict] = {}
    seen_usage_keys: set[str] = set()
    usage_totals = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0}

    header = (
        f"{_ansi(f'[{time.strftime('%H:%M:%S')}]', '90')} "
        f"agent={_ansi(run_ctx['name'], '1;36')} "
        f"model={_ansi(run_ctx['model'], '90')} "
        f"tools={_ansi(run_ctx['tools'], '90')} "
        f"cwd={_ansi(str(Path.cwd()), '90')} "
        f"session={_ansi('off', '90')}\n\n"
    )
    _write_stdout(header)
    line_open = False

    def ensure_line_closed() -> None:
        nonlocal in_text_stream, line_open, pending_trailing_newlines, assistant_stream_open
        if pending_trailing_newlines:
            _write_stdout("\n")
            pending_trailing_newlines = ""
            line_open = False
        if line_open:
            _write_stdout("\n")
            line_open = False
        in_text_stream = False
        assistant_stream_open = False

    def flush_trailing_newlines(compact: bool) -> None:
        nonlocal pending_trailing_newlines, line_open
        if not pending_trailing_newlines:
            return
        if compact:
            _write_stdout("\n")
            line_open = False
        else:
            _write_stdout(pending_trailing_newlines)
            line_open = pending_trailing_newlines[-1] != "\n"
        pending_trailing_newlines = ""

    def split_visible_and_trailing(delta: str) -> tuple[str, str]:
        stripped = delta.rstrip("\n")
        trailing = delta[len(stripped) :]
        return stripped, trailing

    def render_tool_line(status: str, tool_name: str, args_summary: str, summary: str) -> None:
        """渲染单行 tool 摘要，使用灰阶纵线分隔。"""
        status_display = "✓" if status == "done" else "✗"
        status_color = "32" if status == "done" else "31"
        line = (
            f"  {_ansi(status_display, status_color)} "
            f"{_ansi(tool_name, '37')}  "
            f"{_ansi(args_summary, '90')}"
        )
        if summary:
            line += f"  {_ansi(summary, '90')}"
        _write_stdout(f"{line}\n")

    for raw in proc.stdout or []:
        line = raw.strip()
        if not line:
            continue

        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            if in_text_stream:
                _write_stdout("\n")
                in_text_stream = False
            _write_stdout(f"{line}\n")
            continue

        event_type = obj.get("type", "")
        if event_type == "message_update":
            evt = obj.get("assistantMessageEvent", {})
            evt_type = evt.get("type", "")
            if evt_type == "text_delta":
                flush_trailing_newlines(compact=not assistant_stream_open)
                if not in_text_stream:
                    prefix = f"{_ansi(f'[{run_ctx['name']}]', '1;34')} "
                    _write_stdout(prefix)
                    in_text_stream = True
                    line_open = True
                assistant_stream_open = True
                visible, trailing = split_visible_and_trailing(evt.get("delta", ""))
                if visible:
                    _write_stdout(visible)
                    line_open = True
                if trailing:
                    pending_trailing_newlines += trailing
            elif evt_type == "text_end" and in_text_stream:
                in_text_stream = False
                assistant_stream_open = False

        elif event_type == "tool_execution_start":
            flush_trailing_newlines(compact=True)
            ensure_line_closed()
            tools_started += 1
            tool_call_id = str(obj.get("toolCallId", ""))
            pending_tools[tool_call_id] = {
                "name": obj.get("toolName", "tool"),
                "args_summary": _summarize_args(obj.get("args", {})),
            }

        elif event_type == "tool_execution_end":
            flush_trailing_newlines(compact=True)
            ensure_line_closed()
            tool_call_id = str(obj.get("toolCallId", ""))
            tool_info = pending_tools.pop(tool_call_id, {})
            tool_name = tool_info.get("name", obj.get("toolName", "tool"))
            args_summary = tool_info.get("args_summary", _summarize_args(obj.get("args", {})))
            summary = _summarize_content(obj.get("result", {}))
            if obj.get("isError", False):
                tool_errors += 1
                render_tool_line("error", tool_name, args_summary, summary)
            else:
                render_tool_line("done", tool_name, args_summary, summary)

        elif event_type == "message_end":
            message = obj.get("message", {})
            if message.get("role") == "assistant":
                assistant_stream_open = False
                usage_key = str(message.get("responseId") or message.get("timestamp") or id(message))
                if usage_key not in seen_usage_keys:
                    seen_usage_keys.add(usage_key)
                    usage = _extract_usage(message)
                    for key, value in usage.items():
                        usage_totals[key] += value

    ensure_line_closed()

    proc.wait()
    duration = time.time() - start_ts
    status_label = "done" if proc.returncode == 0 else "error"
    status_code = "32" if proc.returncode == 0 else "31"
    footer = (
        "\n"
        f"{_ansi(f'[{status_label}]', status_code)} "
        f"{duration:.1f}s  "
        f"tools={tools_started}  "
        f"errors={tool_errors}  "
        f"tokens=in:{usage_totals['input']} "
        f"out:{usage_totals['output']} "
        f"total:{usage_totals['totalTokens']} "
        f"cache_r:{usage_totals['cacheRead']} "
        f"cache_w:{usage_totals['cacheWrite']}\n"
    )
    _write_stdout(footer)
    return proc.returncode


def _validate_run_mode(mode: str) -> str:
    """校验 run mode。"""
    normalized = mode.strip().lower()
    if normalized not in RUN_MODES:
        console.print(
            f"[red][omp] ERROR:[/red] unknown mode '{mode}': use one of {', '.join(sorted(RUN_MODES))}"
        )
        raise typer.Exit(1)
    return normalized


# ── commands ──────────────────────────────────────────────────────────────────


@app.command()
def install(
    type_: Annotated[str, typer.Argument(metavar="skill|agent", help="skill 或 agent")],
    name: Annotated[str, typer.Argument(help="名称")],
    global_: Annotated[bool, typer.Option("--global", "-g", help="全局安装（默认局部）")] = False,
) -> None:
    """安装 skill 或 agent。"""
    _check_home()
    t = type_.lower()
    if t == "skill":
        src = SKILLS_SRC / name
        if not src.is_dir():
            console.print(f"[red][omp] ERROR:[/red] skill '{name}' not found in {SKILLS_SRC}")
            raise typer.Exit(1)
        base = Path.home() if global_ else Path.cwd()
        _symlink(src, base / ".agents" / "skills" / name)
        _symlink(src, base / ".claude" / "skills" / name)
        # hooks.json 检测和安装
        hooks_json = src / "hooks.json"
        if hooks_json.is_file():
            try:
                from omp_hooks import install_hooks
                install_hooks(hooks_json, name)
                console.print(f"[omp] installed hooks for skill [cyan]{name}[/cyan]")
            except Exception as e:
                console.print(f"[yellow][omp] WARNING:[/yellow] hooks install failed for '{name}': {e}")
    elif t == "agent":
        src = AGENTS_SRC / f"{name}.md"
        if not src.is_file():
            console.print(f"[red][omp] ERROR:[/red] agent '{name}.md' not found in {AGENTS_SRC}")
            raise typer.Exit(1)
        base = Path.home() if global_ else Path.cwd()
        _symlink(src, base / ".pi" / "agents" / f"{name}.md")
    else:
        console.print(f"[red][omp] ERROR:[/red] unknown type '{type_}': use 'skill' or 'agent'")
        raise typer.Exit(1)


@app.command()
def remove(
    type_: Annotated[str, typer.Argument(metavar="skill|agent", help="skill 或 agent")],
    name: Annotated[str, typer.Argument(help="名称")],
    global_: Annotated[bool, typer.Option("--global", "-g", help="全局安装")] = False,
) -> None:
    """卸载 skill 或 agent。"""
    _check_home()
    t = type_.lower()
    base = Path.home() if global_ else Path.cwd()
    if t == "skill":
        _remove_link(base / ".agents" / "skills" / name)
        _remove_link(base / ".claude" / "skills" / name)
        # hooks 移除
        try:
            from omp_hooks import remove_hooks
            remove_hooks(name)
            console.print(f"[omp] removed hooks for skill [cyan]{name}[/cyan]")
        except Exception as e:
            console.print(f"[yellow][omp] WARNING:[/yellow] hooks removal failed for '{name}': {e}")
    elif t == "agent":
        _remove_link(base / ".pi" / "agents" / f"{name}.md")
    else:
        console.print(f"[red][omp] ERROR:[/red] unknown type '{type_}': use 'skill' or 'agent'")
        raise typer.Exit(1)


@app.command(name="list")
def list_cmd(
    type_: Annotated[Optional[str], typer.Option("--type", "-t", metavar="skill|agent", help="过滤类型")] = None,
    global_: Annotated[bool, typer.Option("--global", "-g", help="显示全局安装")] = False,
) -> None:
    """列出已安装的 skills 和 agents。"""
    _check_home()
    base = Path.home() if global_ else Path.cwd()

    show_skills = type_ is None or type_.lower() == "skill"
    show_agents = type_ is None or type_.lower() == "agent"

    if show_skills:
        _list_not_installed_skills(base / ".agents" / "skills")
        _list_dir("skills [Pi]", base / ".agents" / "skills")
        _list_dir("skills [Claude]", base / ".claude" / "skills")

    if show_agents:
        _list_dir("agents [Pi]", base / ".pi" / "agents")
        _list_available_agents()


@app.command()
def run(
    name: Annotated[str, typer.Argument(help="Agent 名称")],
    mode: Annotated[
        str,
        typer.Option(
            "--mode",
            help="运行模式：text（默认最终文本）/ stream（彩色流式文本）/ json（原始事件流）/ interactive（Pi TUI）",
        ),
    ] = "text",
    model: Annotated[Optional[str], typer.Option("--model", "-m", help="LLM 模型（覆盖 agents.json）")] = None,
    prompt: Annotated[Optional[list[str]], typer.Argument(help="提示词（多词无需引号）")] = None,
) -> None:
    """运行 Pi Agent。"""
    _check_home()
    run_mode = _validate_run_mode(mode)
    prompt_str = " ".join(prompt or []).strip()
    if run_mode != "interactive" and not prompt_str:
        console.print(f"[red][omp] ERROR:[/red] prompt is required in {run_mode} mode")
        raise typer.Exit(1)

    run_ctx = _build_run_context(name, model)
    skills_count = len(run_ctx["skill_flags"]) // 2
    skills_display = f"{skills_count} agent-specific skills" if skills_count else "no agent-specific skills"
    console.print(
        f"[omp] agent: [bold]{name}[/bold] | mode: {run_mode} | model: {run_ctx['model']} | "
        f"tools: {run_ctx['tools']} | {skills_display}"
    )
    console.print("")

    cmd = _build_pi_cmd(run_ctx, run_mode, prompt_str)
    if run_mode == "stream":
        rc = _run_stream(cmd, run_ctx)
    else:
        rc = _run_passthrough(cmd)
    raise typer.Exit(rc)


@app.command()
def test(
    name: Annotated[str, typer.Argument(help="skill 名称")],
) -> None:
    """运行 skill T1 静态测试。"""
    _check_home()
    tests_dir = SKILLS_SRC / name / "tests"
    if not tests_dir.is_dir():
        console.print(f"[red][omp] ERROR:[/red] no tests/ directory found for skill '{name}'")
        raise typer.Exit(1)
    console.print(f"[omp] running T1 tests for skill '{name}'...")
    if shutil.which("pytest"):
        rc = subprocess.call(["pytest", str(tests_dir), "-v"])
    else:
        rc = subprocess.call(
            ["python3", "-m", "unittest", "discover", "-s", str(tests_dir), "-p", "test_*.py", "-v"]
        )
    raise typer.Exit(rc)


if __name__ == "__main__":
    app()
