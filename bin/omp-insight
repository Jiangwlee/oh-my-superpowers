#!/usr/bin/env bash
# omp-insight — 项目记忆系统 CLI
#
# 三层记忆：对话 → memory（capture 提取）→ insight（evaluate 提炼）
#
# 子命令:
#   capture  [--source DIR] [--session ID] [--since Nd] [--min-messages N] [--force] [--dry-run] [--model MODEL]
#   recall   [--source DIR] [--format json|md] [--budget N] [--dry-run]
#   evaluate [--source DIR] [--dry-run] [--prompt-file PATH]
#   list     [--source DIR] [--type memory|insight]
#   promote  ID [--reason TEXT] [--source DIR]
#   degrade  ID [--reason TEXT] [--source DIR]
#   delete   ID [--source DIR]
#
# 环境变量:
#   OMP_HOME  oh-my-superpowers 安装路径（默认 ~/.oh-my-superpowers）

set -euo pipefail

SKILL="${OMP_HOME:-$HOME/.oh-my-superpowers}/skills/insight"

exec python3 "$SKILL/scripts/cli.py" "$@"
