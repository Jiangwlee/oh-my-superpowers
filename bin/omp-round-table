#!/usr/bin/env bash
# omp-round-table — Round Table 圆桌讨论 CLI
#
# 两层命名空间:
#   session <cmd>  — session 生命周期管理
#   round <cmd>    — round 级操作（自动取 current_round）

set -euo pipefail

SKILL="${OMP_HOME:-$HOME/.oh-my-superpowers}/skills/round-table"

usage() {
  cat >&2 <<'EOF'
用法：omp-round-table <命名空间> <子命令> [参数...]

Session 生命周期:
  session init <topic> --roles <id1,id2,...> [--context <text|file>]
  session status
  session context [brief|detail]
  session messages [msg-id]
  session end --output-dir <path>
  session post-message <role> <file> --round N --name '...' --action '...' --summary '...'

Round 操作（自动取当前轮次）:
  round spawn          并行启动参与者（current_round + 1）
  round collect        收集并解析当前轮 response，自动 post-message
  round run            spawn + wait + collect 一步完成
  round watch [-f]     实时查看参与者输出
  round attach         连接 tmux session

环境变量:
  ROUND_TABLE_SESSION  指定 session-id（默认使用最新）
  OMP_HOME             oh-my-superpowers 安装路径（默认 ~/.oh-my-superpowers）

EOF
  exit 1
}

cmd="${1:-}"
shift || true

case "$cmd" in
  session)
    sub="${1:-}"; shift || true
    case "$sub" in
      init)     exec bash "$SKILL/scripts/session.sh" init "$@" ;;
      status)   exec bash "$SKILL/scripts/session.sh" status "$@" ;;
      context)  exec bash "$SKILL/scripts/session.sh" get-context "$@" ;;
      messages) exec bash "$SKILL/scripts/session.sh" get-messages "$@" ;;
      end)          exec bash "$SKILL/scripts/session.sh" end "$@" ;;
      post-message) exec bash "$SKILL/scripts/session.sh" post-message "$@" ;;
      *) echo "错误：未知 session 子命令 '${sub:-}'" >&2; usage ;;
    esac
    ;;

  round)
    sub="${1:-}"; shift || true
    case "$sub" in
      spawn)   exec bash "$SKILL/scripts/round.sh" spawn "$@" ;;
      collect) exec bash "$SKILL/scripts/round.sh" collect "$@" ;;
      run)     exec bash "$SKILL/scripts/round.sh" run "$@" ;;
      watch)   exec bash "$SKILL/scripts/round.sh" watch "$@" ;;
      attach)  exec bash "$SKILL/scripts/round.sh" attach "$@" ;;
      *) echo "错误：未知 round 子命令 '${sub:-}'" >&2; usage ;;
    esac
    ;;

  help|--help|-h) usage ;;
  *) echo "错误：未知命令 '${cmd:-}'" >&2; usage ;;
esac
