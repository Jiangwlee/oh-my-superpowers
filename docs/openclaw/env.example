# jvquant
JVQ_TOKEN=
JVQ_BROKER_ACCOUNT=
JVQ_BROKER_PASSWORD=

# runtime
TZ=Asia/Shanghai
TRADER_MODE=auto
LOG_LEVEL=INFO

# storage
DATA_ROOT=./data
CONTRACTS_DIR=./docs/contracts

# notifications
PUSH_PROVIDER=
PUSH_WEBHOOK=
PUSH_SECRET=

# risk and limits
MAX_POSITIONS=5
MAX_DAILY_FILLS=10
SINGLE_ORDER_TARGET_CNY=5000
ADD_STEP_PCT=0.02
STOP_LOSS_FROM_LAST_BUY_PCT=0.20
REPOST_MAX_PER_SYMBOL=5
