{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_intent.schema.json",
  "title": "OrderIntent",
  "type": "object",
  "required": [
    "intent_id",
    "event_id",
    "ts",
    "symbol",
    "action",
    "reason_code",
    "price_policy",
    "target_amount",
    "context"
  ],
  "properties": {
    "intent_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "symbol": { "type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ)$" },
    "action": {
      "type": "string",
      "enum": ["open", "repost_open", "add", "reduce", "take_profit", "stop_loss", "cancel"]
    },
    "reason_code": { "type": "string", "minLength": 1 },
    "price_policy": {
      "type": "string",
      "enum": ["buy_plus_1pct", "sell_minus_1pct"]
    },
    "target_amount": { "type": "number", "minimum": 1 },
    "context": {
      "type": "object",
      "required": ["last_buy_price", "next_add_price", "stop_loss_price", "repost_count_today"],
      "properties": {
        "last_buy_price": { "type": "number", "exclusiveMinimum": 0 },
        "next_add_price": { "type": "number", "exclusiveMinimum": 0 },
        "stop_loss_price": { "type": "number", "exclusiveMinimum": 0 },
        "repost_count_today": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
