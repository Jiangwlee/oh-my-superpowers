{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade_plan.schema.json",
  "title": "TradePlan",
  "type": "object",
  "required": [
    "trade_date",
    "plan_version",
    "max_positions",
    "max_daily_fills",
    "open_window",
    "symbols"
  ],
  "properties": {
    "trade_date": { "type": "string", "format": "date" },
    "plan_version": { "type": "string", "minLength": 1 },
    "max_positions": { "type": "integer", "const": 5 },
    "max_daily_fills": { "type": "integer", "const": 10 },
    "open_window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]:[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]:[0-5][0-9]$" }
      },
      "additionalProperties": false
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "role",
          "entry_batches",
          "repost_max",
          "add_step_pct",
          "stop_loss_from_last_buy_pct",
          "single_order_amount_limit",
          "one_lot_exception_price_source"
        ],
        "properties": {
          "symbol": { "type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ)$" },
          "role": { "type": "string", "enum": ["core", "satellite"] },
          "entry_batches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["target_amount"],
              "properties": {
                "target_amount": { "type": "number", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "repost_max": { "type": "integer", "const": 5 },
          "add_step_pct": { "type": "number", "const": 0.02 },
          "stop_loss_from_last_buy_pct": { "type": "number", "const": 0.2 },
          "single_order_amount_limit": { "type": "number", "const": 5000 },
          "one_lot_exception_price_source": { "type": "string", "const": "previous_close" },
          "invalid_conditions": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
