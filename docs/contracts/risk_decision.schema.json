{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk_decision.schema.json",
  "title": "RiskDecision",
  "type": "object",
  "required": ["intent_id", "allow", "rule_results"],
  "properties": {
    "intent_id": { "type": "string", "minLength": 1 },
    "allow": { "type": "boolean" },
    "rule_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "pass"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "pass": { "type": "boolean" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "reject_reason": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
