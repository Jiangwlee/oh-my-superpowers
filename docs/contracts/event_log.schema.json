{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event_log.schema.json",
  "title": "TradeEventLogLine",
  "type": "object",
  "required": ["event_id", "ts", "symbol", "intent_id", "risk_decision_id", "execution_report_id"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "symbol": { "type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ)$" },
    "intent_id": { "type": "string", "minLength": 1 },
    "risk_decision_id": { "type": "string", "minLength": 1 },
    "execution_report_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["accepted", "rejected", "failed", "filled"] }
  },
  "additionalProperties": true
}
