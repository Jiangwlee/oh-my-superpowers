{
  "name": "A 股每日数据采集",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "betweenHours",
              "betweenHours": [22, 23],
              "betweenMinutes": [0, 0]
            }
          ],
          "daysOfWeek": [1, 2, 3, 4, 5]
        }
      },
      "id": "cron-trigger",
      "name": "Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://task_runner:8000/ashare/collect",
        "sendQuery": false,
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "date",
              "value": "={{ $now.format('yyyy-MM-dd') }}"
            },
            {
              "name": "skip_collect",
              "value": false
            },
            {
              "name": "skip_filter",
              "value": false
            }
          ]
        },
        "options": {
          "timeout": 600000
        }
      },
      "id": "http-request",
      "name": "HTTP Request to task-runner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 300000
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equals",
              "value2": "success"
            }
          ]
        }
      },
      "id": "if-node",
      "name": "Check Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Write success flag file\nconst date = $input.json.result.data_dir.split('/').pop();\nconst timestamp = new Date().toISOString();\nreturn [{\n  json: {\n    success: true,\n    date: date,\n    timestamp: timestamp,\n    message: `Data collected successfully for ${date}`\n  }\n}];"
      },
      "id": "write-success-flag",
      "name": "Write Success Flag",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Log error details\nconst error = $input.json.error || 'Unknown error';\nconst result = $input.json.result || {};\nconst timestamp = new Date().toISOString();\nreturn [{\n  json: {\n    success: false,\n    timestamp: timestamp,\n    error: error,\n    data_dir: result.data_dir || 'N/A'\n  }\n}];"
      },
      "id": "log-error",
      "name": "Log Error Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        400
      ]
    },
    {
      "parameters": {
        "operation": "writeFile",
        "filePath": "/home/bruce/.ashare-assistant/status/success_{{ $json.date }}.flag",
        "fileContent": "={{ $json.timestamp }}"
      },
      "id": "file-write-success",
      "name": "Write Flag File (Success)",
      "type": "n8n-nodes-base.fileWrite",
      "typeVersion": 1.1,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "operation": "writeFile",
        "filePath": "/home/bruce/.ashare-assistant/logs/error_{{ $now.format('yyyyMMdd') }}.log",
        "fileContent": "={{ $json.timestamp }} ERROR: {{ $json.error }}\n"
      },
      "id": "file-write-error",
      "name": "Write Error Log",
      "type": "n8n-nodes-base.fileWrite",
      "typeVersion": 1.1,
      "position": [
        1120,
        400
      ]
    },
    {
      "parameters": {
        "waitTime": 300000,
        "continueWait": true,
        "continueCondition": "={{ $json.retry_count < 3 }}"
      },
      "id": "wait-node",
      "name": "Wait Before Retry",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1340,
        400
      ]
    }
  ],
  "connections": {
    "Cron Trigger": {
      "main": [
        [
          {
            "node": "HTTP Request to task-runner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request to task-runner": {
      "main": [
        [
          {
            "node": "Check Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Status": {
      "main": [
        [
          {
            "node": "Write Success Flag",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write Success Flag": {
      "main": [
        [
          {
            "node": "Write Flag File (Success)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Error Details": {
      "main": [
        [
          {
            "node": "Write Error Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write Error Log": {
      "main": [
        [
          {
            "node": "Wait Before Retry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v3"
  },
  "staticData": null,
  "tags": [
    {
      "id": "ashare",
      "name": "ashare"
    }
  ]
}
