# Task Runner Environment Variables
# Copy this file to .env and modify as needed

# Timezone (default: Asia/Shanghai)
TZ=Asia/Shanghai

# Task Runner Configuration
UVICORN_WORKERS=1
UVICORN_PORT=8000

# Ashare-Data Configuration
# This is the path INSIDE the container (/root/.ashare-assistant)
# The volume mount maps it to your host path: /home/bruce/.ashare-assistant
ASHARE_OUTPUT_DIR=/root/.ashare-assistant

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=10

# ──────────────────────────────────────────────────────
# JVQuant Broker Account Configuration (Optional)
# ──────────────────────────────────────────────────────
# 
# Option 1: Use environment variables (recommended for Docker)
# Set these values directly in .env file
JVQUANT_APP_TOKEN=your_jvquant_token_here
EASTMONEY_ACCOUNT=your_eastmoney_account
EASTMONEY_PASSWORD=your_eastmoney_password
#
# Option 2: Use credentials file (mount via volume)
# Set the path below and mount the file in docker-compose.yml
# Default path inside container: /root/.ashare-data/jvquant.json
# Host path should be: /home/bruce/.ashare-data/jvquant.json
JVQUANT_CREDENTIALS_PATH=/root/.ashare-data/jvquant.json
#
# Note: If both options are configured, environment variables take precedence.
# If neither is configured, broker account data collection will be skipped.
